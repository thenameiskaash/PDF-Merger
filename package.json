{
  "name": "PDF-Merger",
  "version": "1.0.2",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npx electron .",
    "electron:build": "vite build && electron-builder build --win"
  },
  "build": {
    "appId": "com.yourname.pdfmerger",
    "productName": "PDF Merger",
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "pdf-lib": "^1.17.1"
  }
}